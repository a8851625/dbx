# DBX Enterprise backend env
APP_NAME=DBX Enterprise API
APP_VERSION=0.5.19-enterprise-web
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=4224
APP_STATIC_DIR=/app/static
DBX_DATA_DIR=/app/data
DATABASE_URL=postgresql+psycopg://dbx:dbx@postgres:5432/dbx_enterprise
DATABASE_ECHO=false
SESSION_COOKIE_NAME=dbx_enterprise_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=28800
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=Enterprise SSO
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Browser-facing OIDC URLs. Compose/shared test can point these at the public IdP host.
OIDC_AUTHORIZE_URL=
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_DISCOVERY_URL=
OIDC_SCOPES=openid profile email
OIDC_REDIRECT_URI=http://localhost:4224/api/v1/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:4224/login
OIDC_LOGOUT_URL=
# Backend-facing OIDC URLs. In Docker these can use service DNS names instead of the public host.
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_ALLOWED_EMAIL_DOMAINS=
OIDC_FRONTEND_LOGIN_PATH=/login
OIDC_FRONTEND_POST_LOGIN_PATH=/
OIDC_DEFAULT_ROLE=viewer
OIDC_ROLE_CLAIM=dbx_role
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_ROLES=dbx-admin,admin
OIDC_EDITOR_ROLES=dbx-editor,editor
OIDC_VIEWER_ROLES=dbx-viewer,viewer
# Keep mock mode for standalone pnpm/FastAPI development. deploy/docker-compose.yml overrides this to false.
OIDC_MOCK_MODE=true
OIDC_MOCK_SUBJECT=mock-admin
OIDC_MOCK_EMAIL=admin@example.com
OIDC_MOCK_NAME=DBX Administrator
OIDC_MOCK_USERNAME=admin
DBX_WEB_BASE_URL=http://dbx:4224
DBX_WEB_INTERNAL_TOKEN=dbx-enterprise-internal
ENTERPRISE_INTERNAL_TOKEN=dbx-enterprise-internal
CONFIG_MIGRATION_AUTO_ENABLED=true
CONFIG_MIGRATION_AUTO_SOURCE=
CONFIG_MIGRATION_AUTO_OVERWRITE_EXISTING=false
APPROVAL_SCHEDULER_INTERVAL_SECONDS=15
APPROVAL_EXECUTION_LOCK_SECONDS=1800
